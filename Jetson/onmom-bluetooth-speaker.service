[Unit]
Description=Keep the JBL Flip 6 available as a PipeWire output
After=pipewire.service wireplumber.service
Wants=pipewire.service wireplumber.service

[Service]
Type=simple
ExecStart=%h/.local/bin/onmom-bluetooth-speaker-keepalive
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
